# Пример переменных окружения. Реальные значения хранятся только в .env (его нет в git).
# Скопируй файл: cp .env.example .env, и замени change_me на свои значения.

# База данных core_db: приложению выдан отдельный пользователь, миграции Flyway идут под другим
CORE_DB_NAME=core_db
# Административный пароль PostgreSQL: нужен только при первом создании БД (скрипт infra/postgres/init)
CORE_DB_ADMIN_PASSWORD=change_me
CORE_DB_APP_USER=core_app
CORE_DB_APP_PASSWORD=change_me
CORE_DB_MIGRATION_USER=core_migrator
CORE_DB_MIGRATION_PASSWORD=change_me

# Подпись JWT (не короче 32 символов, иначе ядро не запустится) и токен для вызовов BFF -> ядро (X-Internal-Token)
JWT_SECRET=change_me_change_me_change_me_change_me
INTERNAL_TOKEN=change_me

# Профиль SLA: PROD (рабочие часы) или DEMO (минуты)
SLA_PROFILE=PROD
