{
  "mappings": [
    {
      "name": "Любой другой ИНН: 404",
      "priority": 10,
      "request": {
        "method": "GET",
        "urlPathPattern": "/billing/v1/accounts/.*/balance"
      },
      "response": {
        "status": 404,
        "bodyFileName": "problem-not-found.json",
        "headers": {
          "Content-Type": "application/problem+json; charset=utf-8",
          "X-Correlation-Id": "{{request.headers.X-Correlation-Id}}"
        }
      }
    }
  ]
}
