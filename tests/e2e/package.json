{
  "name": "b2b-order-flow-e2e",
  "version": "0.1.0",
  "private": true,
  "description": "Сквозные тесты и контрактные тесты моков B2B-Order-Flow",
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "playwright test",
    "test:fixtures": "playwright test --project=fixtures",
    "test:mocks": "playwright test --project=mocks",
    "test:api": "playwright test --project=api",
    "list": "playwright test --list",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^22.0.0",
    "typescript": "6.0.3"
  }
}
